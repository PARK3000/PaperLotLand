{
  "name": "paperlotland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "npx tsx scripts/validate-blog-images.ts && npx tsx scripts/setup-db.ts",
    "build": "next build",
    "postbuild": "npx tsx scripts/ping-indexnow.ts",
    "validate:blog-images": "npx tsx scripts/validate-blog-images.ts",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:links": "vitest run __tests__/internal-links.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:setup": "npx tsx scripts/setup-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@microsoft/clarity": "^1.0.2",
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "googleapis": "^171.4.0",
    "next": "^15.1.0",
    "posthog-js": "^1.370.1",
    "posthog-node": "^5.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cheerio": "^1.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "turndown": "^7.2.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
