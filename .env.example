# ===========================================
# We Buy Any Vegas House - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real credentials

# ===========================================
# REQUIRED: AI (Claude) — Admin Blog Editor
# ===========================================

# Anthropic API key for AI-powered blog writing in /admin/blogs
# Get yours: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Secret used to sign admin session cookies — generate a strong random string before deploying
ADMIN_SESSION_SECRET=change-this-to-a-random-string

# ===========================================
# REQUIRED: Database & Storage (Admin Panel)
# ===========================================

# Neon Postgres — used for admin_users and blog_posts tables
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=

# Vercel Blob — used for blog image uploads
# Get from: Vercel dashboard → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=

# ===========================================
# REQUIRED: MCP Server Credentials
# ===========================================

# FireCrawl API (Web Scraping)
# Get your key: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# DataForSEO API (Keyword Research & SEO Analysis)
# Get credentials: https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ===========================================
# REQUIRED: Site Configuration
# ===========================================

# Production URL (update for deployment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# OPTIONAL: WordPress Integration
# ===========================================

# WordPress REST API (if syncing content from existing WP site)
# WP_API_URL=https://yourdomain.com/wp-json
# WP_USERNAME=
# WP_APP_PASSWORD=

# ===========================================
# OPTIONAL: Google Services
# ===========================================

# Google Search Console API
# Place service account JSON at: config/gcs-credentials.json (gitignored)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ===========================================
# OPTIONAL: Form & Lead Management
# ===========================================

# Webhook for form submissions (n8n)
LEADS_WEBHOOK_URL=https://n8n.alchemylv.com/webhook/gravity-forms-submission

# Podio webhook URLs (lead delivery fallback)
PODIO_FALLBACK_URL=
PODIO_FULL_SUBMIT_URL=

# Email notifications for new leads
NOTIFICATION_EMAIL=

GOOGLE_PLACES_API_KEY=your_key_here

# Google Places Autocomplete (browser-side, for address form fields)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_key_here